# Supabase — copie este arquivo para .env.local e preencha com os valores de
# Supabase Dashboard -> Project Settings -> API.
#
# ATENÇÃO: a URL da API NÃO tem o prefixo "db." (esse prefixo só aparece na
# connection string do Postgres). Ex.: https://owerkoftuhektkwiemvw.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (sb_publishable_...) — ou a "anon key" legada. Pode ir para o
# navegador; o acesso às linhas é garantido por RLS no banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só para deploy atrás de proxy/túnel (Tailscale, Cloudflare, nginx). Hostnames
# separados por vírgula, sem "https://". Sem isso o login (Server Action) pode ser
# recusado pela proteção CSRF do Next. Ex.: capital.meu-tailnet.ts.net
APP_ALLOWED_ORIGINS=
