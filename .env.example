# Capital — copie este arquivo para .env.local e preencha. Nunca versione o .env.local.

# Postgres (veja deploy/postgres/README.md).
#   Produção, no Docker do Pi:  postgres://capital:<CAPITAL_DB_PASSWORD>@capital-postgres:5432/capital
#   Desenvolvimento no PC:      postgres://capital_dev:<CAPITAL_DEV_DB_PASSWORD>@100.x.y.z:5432/capital_dev
DATABASE_URL=

# Login (Better Auth). Segredo: `openssl rand -base64 32` — um por ambiente; trocar desloga todo mundo.
BETTER_AUTH_SECRET=
# URL pública do app; os links dos e-mails apontam para ela. Em desenvolvimento: http://localhost:3000
BETTER_AUTH_URL=

# E-mails de confirmação de conta e de redefinição de senha. Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=seu Gmail e SMTP_PASS=uma "senha de app" (exige verificação em duas
# etapas: myaccount.google.com/apppasswords). Sem SMTP_HOST, os e-mails só aparecem no log do servidor.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente (opcional). Padrão: "Capital <SMTP_USER>".
MAIL_FROM=

# Só para deploy atrás de proxy/túnel (Cloudflare, Tailscale, nginx). Hostnames separados por
# vírgula, sem "https://". Sem isso o login (Server Action) pode ser recusado pela proteção CSRF
# do Next. Ex.: capital.rincon.dev.br
APP_ALLOWED_ORIGINS=

# Administrador do servidor (opcional). Não libera nenhum recurso: todos os módulos são de todos os
# usuários. Só essa conta vê detalhes de configuração, como a URI de retorno do Google na tela do
# monitor de Gmail.
OWNER_EMAIL=


# Notificações (Web Push). Gere um par de chaves por ambiente (dev e Pi) com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Trocar as chaves invalida as inscrições: cada aparelho precisa ativar as notificações de novo.
# VAPID_SUBJECT é um contato para os serviços de push (https://... ou mailto:...).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Assina o botão "Realizado ✅" das notificações de lembrete (o token vale 36 h). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sem ele, as notificações saem sem o botão.
ACTION_TOKEN_SECRET=

# Lançar por voz ou texto: a IA local (grátis, sem chave). whisper.cpp (whisper-server com --convert)
# e Ollama. No Pi e no PC pela Tailscale: http://100.x.y.z:8090 e http://100.x.y.z:11434.
# Sem as duas URLs, o módulo responde que a IA não está configurada.
WHISPER_URL=
OLLAMA_URL=
# Modelo do Ollama (padrão qwen2.5:1.5b).
OLLAMA_MODEL=
# Monitor de Gmail ("Login com Google", só leitura). Um cliente do Google para o servidor todo; cada
# usuário conecta o próprio Gmail. No Google Cloud: ative a Gmail API e, em APIs e serviços →
# Credenciais, crie um ID do cliente OAuth do tipo "Aplicativo da Web", com a URI de
# redirecionamento <BETTER_AUTH_URL>/api/v1/gmail/oauth/callback. Publique a tela de consentimento
# ("Em produção"): sem a verificação do Google, até 100 pessoas conseguem conectar e cada uma vê
# uma vez o aviso "app não verificado". Em "Teste", só os testadores cadastrados conectam e a
# conexão cai a cada 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: outra URI de retorno (padrão: <BETTER_AUTH_URL>/api/v1/gmail/oauth/callback).
GOOGLE_REDIRECT_URI=
# Cifra o token do Gmail guardado no banco (AES-256-GCM). Uma por ambiente; trocar exige conectar
# o Gmail de novo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Agenda em segundo plano (lembretes e cotações), dentro do próprio servidor. SCHEDULER=off desliga
# (útil se você rodar um segundo servidor apontando para o mesmo banco).
SCHEDULER=

# --- Proteção do servidor (todas opcionais; os valores abaixo são os padrões) ---
# Guarda de carga (lib/server/loadGuard.ts). A média de requisições por segundo (últimos 5 s)
# a partir da qual o dono (OWNER_EMAIL) recebe um aviso, e a partir da qual o servidor pausa:
# por LOAD_SHED_SECONDS toda requisição recebe "volte em instantes" (a pausa se estende enquanto
# o pico continuar). Um único IP que passar de LOAD_IP_PER_10S em 10 segundos ou de LOAD_IP_PER_MINUTE
# por minuto é bloqueado sozinho — assim um IP só nunca consegue pausar o servidor para todos.
LOAD_ALERT_RPS=20
LOAD_SHED_RPS=50
LOAD_SHED_SECONDS=60
LOAD_IP_PER_MINUTE=600
LOAD_IP_PER_10S=100
# Temperatura da placa (°C, a zona térmica mais quente): aviso ao dono e pausa do servidor.
# Acima do aviso, a IA (lançar por voz) também para até esfriar.
TEMP_ALERT_C=75
TEMP_SHED_C=85
# Teto de e-mails (confirmação e redefinição de senha) enviados pelo SMTP, para ninguém gastar a
# cota do seu Gmail criando contas para endereços de outras pessoas.
MAIL_MAX_PER_HOUR=30
MAIL_MAX_PER_DAY=200
# Cabeçalho com o IP real do visitante, posto pelo proxy (padrão: cf-connecting-ip, da Cloudflare).
# Só vale porque a porta do app fica presa a 127.0.0.1 (docker-compose.yml): ninguém fala direto
# com ele para forjar o cabeçalho.
TRUSTED_IP_HEADER=
# Endereço onde o container publica a porta 3000 (padrão 127.0.0.1: só o próprio Pi). Mude só se o
# cloudflared alcança o app por outro caminho (ex.: 172.17.0.1, o gateway da rede Docker).
CAPITAL_BIND=

# Só desenvolvimento: aparelhos que testam o `npm run dev` pela rede/VPN (IPs ou hosts, por vírgula).
DEV_ALLOWED_ORIGINS=
