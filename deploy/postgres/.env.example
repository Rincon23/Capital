# Copie para `.env` nesta pasta (no Orange Pi) e preencha. Nunca versione o `.env`.
# Gere cada senha com:  openssl rand -hex 24
# (só letras e números: entram direto na DATABASE_URL, sem precisar escapar nada)

# Superusuário "postgres": administração (docker exec … psql) e backup.
POSTGRES_PASSWORD=
# Usuário "capital", dono do banco de produção "capital". Vai na DATABASE_URL do app.
CAPITAL_DB_PASSWORD=
# Usuário "capital_dev", dono do banco "capital_dev" (desenvolvimento). Deixe vazio para não criar.
CAPITAL_DEV_DB_PASSWORD=
# As três senhas acima só são aplicadas na PRIMEIRA inicialização (pasta de dados vazia).
# Para trocar depois: docker exec -it capital-postgres psql -U postgres -c "ALTER ROLE capital PASSWORD '...'"

# Caminhos absolutos no Pi, fora de qualquer repositório git.
DATA_DIR=/home/orangepi/capitalapp/data/postgres
# Leve esta pasta para fora do Pi (Syncthing, disco externo…): backup só no Pi não protege
# contra perda do Pi.
BACKUP_DIR=/home/orangepi/capitalapp/data/backups

# Acesso de desenvolvimento pela Tailscale (opcional). Com COMPOSE_PROFILES=dev sobe o container
# `capital-db-dev-access`, que publica a porta 5432 só no IP da Tailscale do Pi (`tailscale ip -4`).
# O `install.sh --tailscale` preenche as duas linhas. Sem elas, o banco só é acessível no próprio Pi.
#COMPOSE_PROFILES=dev
#DEV_ACCESS_ADDR=100.x.y.z:5432

# Hora do backup diário (0–23, horário de Brasília) e dono dos arquivos de backup (id -u / id -g).
BACKUP_HOUR=3
BACKUP_UID=1000
BACKUP_GID=1000
